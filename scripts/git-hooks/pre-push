#!/bin/bash
# Pre-push hook: every push to main builds the app and publishes a GitHub
# release (see scripts/release.sh). Installed once per clone with:
#   git config core.hooksPath scripts/git-hooks
#
# A failing build aborts the push; bypass with: git push --no-verify
set -u
ZERO=0000000000000000000000000000000000000000
STATUS=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "$local_sha" != "$ZERO" ]; then
    if ! "$(git rev-parse --show-toplevel)/scripts/release.sh" "$local_sha"; then
      echo "pre-push: release build failed — push aborted (bypass with git push --no-verify)" >&2
      STATUS=1
    fi
  fi
done
exit $STATUS
